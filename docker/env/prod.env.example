GRCPC_APP_IMAGE=grcpc-app:latest
APP_PORT=8080

DB_URL=jdbc:oracle:thin:@//oracle-host.example.com:1521/ORCLPDB1
DB_USERNAME=GRCPC
DB_PASSWORD=change-me
DB_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_SCHEMA=GRCPC

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=/var/lib/minio/data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
GRCPC_MINIO_ENABLED=true
GRCPC_MINIO_ACCESS_KEY=grcpc-app
GRCPC_MINIO_SECRET_KEY=change-me-app-secret
GRCPC_MINIO_BUCKET=grc-documents
GRCPC_MINIO_ENDPOINT=http://minio:9000
GRCPC_MINIO_PUBLIC_ENDPOINT=https://files.example.com
GRCPC_MINIO_PRESIGNED_URL_EXPIRY_MINUTES=15
GRCPC_MINIO_DEFAULT_MAX_UPLOAD_SIZE_MB=25
GRCPC_MINIO_TEMP_TTL_MINUTES=120
GRCPC_MINIO_TEMPORARY_PREFIX=master-data/document/temp
GRCPC_MINIO_PERMANENT_PREFIX=master-data/document/permanent
GRCPC_MINIO_LIFECYCLE_MODE=APPLY
GRCPC_MINIO_TEMP_EXPIRATION_ENABLED=true
GRCPC_MINIO_TEMP_EXPIRATION_RULE_ID=grcpc-temp-object-expiration
GRCPC_MINIO_TEMP_EXPIRATION_DAYS=2
MINIO_VOLUME=grcpc_prod_minio

JAVA_OPTS=-Xms512m -Xmx1024m
