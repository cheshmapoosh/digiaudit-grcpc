# GRCPC portable test environment
# Used by grcpc-app.bat and compose.test-jar.yml

# Docker images
JAVA_IMAGE=eclipse-temurin:21-jre-noble
ORACLE_IMAGE=gvenzl/oracle-free:23-slim
MINIO_IMAGE=minio/minio:latest

# Published ports on Windows host
APP_PORT=8080
ORACLE_PORT=1521
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Oracle test database
ORACLE_SYS_PASSWORD=oracle
DB_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
DB_USERNAME=GRCPC
DB_PASSWORD=grcpc
DB_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_SCHEMA=GRCPC
FLYWAY_ENABLED=true

# MinIO test storage
MINIO_DATA_DIR=/var/lib/minio/data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRCPC_MINIO_ENABLED=true
GRCPC_MINIO_ENDPOINT=http://minio:9000
GRCPC_MINIO_BUCKET=grc-documents
GRCPC_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
GRCPC_MINIO_ACCESS_KEY=minioadmin
GRCPC_MINIO_SECRET_KEY=minioadmin
GRCPC_MINIO_PRESIGNED_URL_EXPIRY_MINUTES=15
GRCPC_MINIO_DEFAULT_MAX_UPLOAD_SIZE_MB=25
GRCPC_MINIO_TEMP_TTL_MINUTES=120
GRCPC_MINIO_TEMPORARY_PREFIX=master-data/document/temp
GRCPC_MINIO_PERMANENT_PREFIX=master-data/document/permanent
GRCPC_MINIO_LIFECYCLE_MODE=APPLY
GRCPC_MINIO_TEMP_EXPIRATION_ENABLED=true
GRCPC_MINIO_TEMP_EXPIRATION_RULE_ID=grcpc-temp-object-expiration
GRCPC_MINIO_TEMP_EXPIRATION_DAYS=2

# Docker volumes
ORACLE_VOLUME=grcpc_test_oradata
MINIO_VOLUME=grcpc_test_minio
APP_LOG_VOLUME=grcpc_test_app_logs

# Java and logging
JAVA_OPTS=-Xms256m -Xmx512m
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
