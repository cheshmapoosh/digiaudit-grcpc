# Copy to stage.env beside compose.stage.yml and grcpc-app.stage.sh.
# Replace every example credential and endpoint before running.
JAVA_IMAGE=eclipse-temurin:21-jre-noble
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
APP_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# External Oracle. DB_SCHEMA must be the login user's own schema.
DB_URL=jdbc:oracle:thin:@//oracle-stage.example.com:1521/ORCLPDB1
DB_USERNAME=GRCPC_STAGE
DB_PASSWORD=change-me
DB_SCHEMA=GRCPC_STAGE
FLYWAY_ENABLED=true

MINIO_ROOT_USER=grcpc-stage
MINIO_ROOT_PASSWORD=change-me
GRCPC_MINIO_PUBLIC_ENDPOINT=https://files.example.com
GRCPC_MINIO_BUCKET=grc-documents
